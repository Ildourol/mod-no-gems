[worldserver]

###################################################################################################
# MOD NO GEMS CONFIGURATION
###################################################################################################
#
#    NoGems.Enable
#        Description: Master switch to enable or disable the mod-no-gems module.
#        Default:     1 - Enabled
#                     0 - Disabled
#

NoGems.Enable = 1

#
#    NoGems.DisableGemEffects
#        Description: Suppress all stat, aura, rating, and combat effects of socketed gems.
#                     Original gems remain stored on items in the database.
#        Default:     1 - Enabled (suppressed)
#                     0 - Disabled (normal gem stats apply)
#

NoGems.DisableGemEffects = 1

#
#    NoGems.DisableSocketBonuses
#        Description: Suppress socket matching bonuses on items.
#        Default:     1 - Enabled (suppressed)
#                     0 - Disabled (normal socket bonuses apply)
#

NoGems.DisableSocketBonuses = 1

#
#    NoGems.BlockSocketing
#        Description: Reject all attempts to insert or replace gems in item sockets.
#        Default:     1 - Enabled (socketing blocked)
#                     0 - Disabled (socketing allowed)
#

NoGems.BlockSocketing = 1

#
#    NoGems.Replacement.Enable
#        Description: Enable one-time randomized persistent replacement affixes for items
#                     with sockets.
#        Default:     1 - Enabled
#                     0 - Disabled
#

NoGems.Replacement.Enable = 1

#
#    NoGems.Replacement.AllowProfessionExclusive
#        Description: Allow profession-exclusive gems (e.g. Dragon's Eye JC gems) in the
#                     replacement affix candidate pool.
#        Default:     0 - Disabled (balanced normal gem pool)
#                     1 - Enabled
#

NoGems.Replacement.AllowProfessionExclusive = 0

#
#    NoGems.Replacement.MinItemQuality
#        Description: Minimum item quality (0 = Poor, 1 = Common, 2 = Uncommon, 3 = Rare,
#                     4 = Epic, 5 = Legendary) eligible for replacement affixes.
#        Default:     2 (Uncommon)
#

NoGems.Replacement.MinItemQuality = 2

#
#    NoGems.Replacement.MinItemLevel
#        Description: Minimum item level required to receive replacement affixes.
#        Default:     1
#

NoGems.Replacement.MinItemLevel = 1

#
#    NoGems.Replacement.MaxItemLevel
#        Description: Maximum item level eligible for replacement affixes (0 = no limit).
#        Default:     0
#

NoGems.Replacement.MaxItemLevel = 0

#
#    NoGems.DebugLogging
#        Description: Enable detailed debug logging for mod-no-gems.
#        Default:     0 - Disabled
#                     1 - Enabled
#

NoGems.DebugLogging = 0
